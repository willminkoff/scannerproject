[Unit]
Description=SB3 Bluetooth Audio Heal
After=network-online.target bluetooth.service
Wants=network-online.target bluetooth.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/scannerproject
EnvironmentFile=-/etc/airband-ui.conf
ExecStart=/usr/bin/env bash /home/ubuntu/scannerproject/scripts/bt-audio-heal.sh
TimeoutStartSec=90
