# backups & editor junk
*.bak*
*.backup*
*.broken*
*.swp
*~
nohup.out
patch.diff
.DS_Store

# runtime
/run/
/tmp/

# runtime logs
admin/logs/

# secrets (we keep an example file instead)
icecast/icecast.xml
# mac icecast configs carry inline source/admin passwords — never commit (per-host, live on the box)
etc/mac/icecast.xml
etc/mac/icecast-*.xml
etc/mac/icecast-credentials.env
etc/mac/icecast-*-credentials.env

# Python bytecode and caches
__pycache__/
*.py[cod]
*.pyo

# pre-edit backup files (safety snapshots, not for git)
*.pre-*

# macOS resource forks
._*

# codex/agent backup directories
.codex-backups/

# runtime / data directories
/runtime/
/data/

# host-side diagnostic snapshots (reboot captures, profile inventories) —
# one-off scratch generated on the box, not source of truth
/snapshots/

# disco bulk RF / FCC data (regeneratable from upstream sources)
disco/training_captures/
disco/uls/
disco/cdbs/

# local databases
*.db
*.db-shm
*.db-wal

# Runtime-written profile state.  The airband UI rewrites gain/squelch
# (look for "# UI_CONTROLLED" markers) on every slider adjustment, and
# favorites_runtime regenerates rtl_airband_hp3_favorites_*.conf wholesale
# on every favorite tile tap.  These files diverge from origin on normal
# use, so we untrack them rather than constantly fight a dirty working
# tree.  A fresh deploy seeds them via the first profile activation /
# managed-analog-controls bootstrap; nothing about a clean checkout needs
# them present.
profiles/rtl_airband_*.conf
profiles/managed_analog_controls.json
profiles/profiles.json

# Runtime-tuned disco sweep config (manual tuning, not source of truth)
disco/configs/sweep.yaml

# Local Claude Code state (settings, worktrees) — never commit
.claude/
# hp_state.json pre-save snapshots (runtime, never committed)
data/hp_state.json.history/

# deploy runtime logs (never commit)
.deploy-logs/
etc/mac/icecast-credentials.env
etc/mac/icecast.xml
logs/
**/__pycache__/

# Phase 4.2 reconciler: per-host runtime config (the enable flag lives on the
# box, not in the repo). Committing it would ship one host's ACTIVE/DISABLED
# state to every other host on the next deploy.
config/reconciler.json

# Wizard-generated analog profiles. User data, per-host, written at runtime by
# POST /api/scan/state — never version-controlled, and `sb3-ctl update` must
# leave them alone.
/user-profiles/
