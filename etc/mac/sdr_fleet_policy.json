{
  "_comment": "Foolproof SDR fleet policy for the Mac mini (replaces micro). Single source of truth for device->role allocation, RSPduo modes, USB grouping, and broker invariants. The tuner-broker, config generators, and wiring card all read THIS file. Address devices by serial ONLY; USB position is never trusted. See docs/mac-mini-port.md.",
  "version": 1,
  "invariants": {
    "max_concurrent_dual_tuner_rspduo": 1,
    "_why": "Two concurrent dual-tuner RSPduos deterministically segfault the shared sdrplay daemon (0x6bed) and corrupt live IQ. Exactly one device (RSP-B) may be dual-tuner; the broker REFUSES any second dual-tuner claim.",
    "rspduo_open_gap_sec": 2.0,
    "master_before_slave": true,
    "min_restart_interval_sec": 30,
    "address_by": "serial",
    "powered_hubs_required": true,
    "max_rtl_streams_per_usb_controller": 5
  },
  "rspduo_daemon": {
    "launchd_label": "com.sdrplay.service",
    "api_version": "3.15.1",
    "_note": "One daemon brokers BOTH RSPduos. All sdrplay_api_Open calls funnel through the broker, spaced by rspduo_open_gap_sec."
  },
  "devices": [
    {
      "id": "RSP-A", "kind": "rspduo", "serial": "180903EF32", "label": "RSP-DIGITAL",
      "role": "op25-p25-primary", "mode": "ST", "tuner": 1, "sample_rate_hz": 8000000,
      "usb_group": "G1", "shared_with": [], "dual_tuner": false,
      "_sdrtrunk_note": "True 8 MHz single-tuner requires SDRTrunk Java pref rsp.duo.tuner.mode=SINGLE_1 (defaults to DUAL, which forces 2 MHz). See docs/sdrtrunk-shutdown-hook-fork.md / memory.",
      "device_args": "driver=sdrplay,serial=180903EF32,rspduo_mode=ST,rspduo_tuner=1"
    },
    {
      "id": "RSP-B", "kind": "rspduo", "serial": "1809063632", "label": "RSP-AIRBAND",
      "role": "airband+ground", "mode": "MA+SL", "sample_rate_hz": 2000000,
      "usb_group": "G2", "shared_with": [], "dual_tuner": true,
      "tuners": [
        { "role": "airband", "mode": "MA", "tuner": 1, "bandwidth_hz": 1536000,
          "device_args": "driver=sdrplay,serial=1809063632,rspduo_mode=MA,rspduo_tuner=1,bandwidth=1536000" },
        { "role": "ground", "mode": "SL", "tuner": 2, "bandwidth_hz": 1536000,
          "device_args": "driver=sdrplay,serial=1809063632,rspduo_mode=SL,rspduo_tuner=2,bandwidth=1536000" }
      ],
      "_critical": "bandwidth_hz=1536000 on BOTH tuners is MANDATORY — MA without explicit bandwidth produces broadband noise (see airband-master-mode-root-cause)."
    },
    { "id": "RTL-1", "kind": "rtlsdr", "serial": "56919602", "serial_status": "PLACEHOLDER-flash-with-rtl_eeprom",
      "label": "DIG-CTRL-2", "role": "op25-control-2", "sample_rate_hz": 2400000, "usb_group": "G3", "shared_with": [] },
    { "id": "RTL-2", "kind": "rtlsdr", "serial": "14306619", "serial_status": "PLACEHOLDER-flash-with-rtl_eeprom",
      "label": "DIG-CTRL-3", "role": "op25-control-3", "sample_rate_hz": 2400000, "usb_group": "G3", "shared_with": [] },
    { "id": "RTL-3", "kind": "rtlsdr", "serial": "70613472", "serial_status": "confirmed-on-micro",
      "label": "DIG-TRAFFIC/WF-A", "role": "op25-traffic", "sample_rate_hz": 2400000, "usb_group": "G3",
      "shared_with": ["waterfall-a"], "_share": "op25 traffic XOR waterfall channel A, broker-arbitrated" },
    { "id": "RTL-4", "kind": "rtlsdr", "serial": "61108285", "serial_status": "confirmed-on-micro",
      "label": "WF-B/ACARS", "role": "waterfall-b", "sample_rate_hz": 2000000, "usb_group": "G4",
      "shared_with": ["acars"], "_share": "waterfall channel B XOR acarsdec, broker-arbitrated" },
    { "id": "RTL-5", "kind": "rtlsdr", "serial": "83241970", "serial_status": "confirmed-on-micro (RTL-SDR Blog V4, USB-finicky)",
      "label": "VDL2", "role": "vdl2", "sample_rate_hz": 2400000, "usb_group": "G4", "shared_with": [] },
    { "id": "RTL-6", "kind": "rtlsdr", "serial": "45469635", "serial_status": "PLACEHOLDER-flash-with-rtl_eeprom",
      "label": "DISCO/SONDE", "role": "disco-sweep", "sample_rate_hz": 2400000, "usb_group": "G4",
      "shared_with": ["radiosonde"], "_share": "disco sweep XOR radiosonde_auto_rx, broker-arbitrated" },
    { "id": "RTL-7", "kind": "rtlsdr", "serial": "80000003", "serial_status": "confirmed-on-micro",
      "label": "SPARE", "role": "spare", "sample_rate_hz": 2400000, "usb_group": "G4",
      "shared_with": ["disco-2"], "_share": "hot spare; broker promotes it for any failed dedicated dongle" }
  ],
  "usb_groups": {
    "G1": { "host": "rear Thunderbolt port 1", "hub": null, "_note": "RSP-A direct-cabled, isolated bus, no hub" },
    "G2": { "host": "rear Thunderbolt port 2", "hub": null, "_note": "RSP-B direct-cabled, isolated bus, no hub" },
    "G3": { "host": "front USB-C controller", "hub": "H1 (powered, own PSU)", "members": ["RTL-1","RTL-2","RTL-3"] },
    "G4": { "host": "rear Thunderbolt port 3", "hub": "H2 (powered, own PSU)", "members": ["RTL-4","RTL-5","RTL-6","RTL-7"] }
  },
  "broker": {
    "launchd_label": "com.scannerproject.tuner-broker",
    "socket": "/opt/scannerproject/run/broker.sock",
    "lock_dir": "/opt/scannerproject/run/locks",
    "state_file": "/opt/scannerproject/run/broker_state.json",
    "lock_key": "physical-serial",
    "liveness_sweep_sec": 2,
    "stale_lock_grace_sec": 5,
    "usb_release_grace_sec": 0.5,
    "daemon_heartbeat_sec": 30,
    "daemon_recycle_min_interval_sec": 60,
    "clear_locks_at_boot": true
  }
}
