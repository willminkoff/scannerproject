# scannerproject.env — macOS (Apple Silicon) runtime configuration
# =============================================================================
# This single file is the linchpin of the Mac mini port. ui/config.py reads
# almost every path and service name from os.getenv(...) with a Linux default,
# so remapping them here moves the whole stack onto macOS WITHOUT touching code.
#
# Load it into every scannerproject process (UI, op25 bridge, decoders) e.g.:
#     set -a; source /opt/scannerproject/etc/scannerproject.env; set +a
# The launchd plists / supervisor (see docs/mac-mini-port.md) source this too.
#
# Filesystem layout (created by scripts/mac-bootstrap.sh):
#   /opt/scannerproject/etc   <- configs (was /usr/local/etc, /etc/scannerproject)
#   /opt/scannerproject/run   <- volatile runtime state (was /run)
#   /opt/scannerproject/log   <- logs (was /var/log/*)
#   /opt/scannerproject/venv  <- Python 3.12 venv (system python is 3.14 = no audioop)
#   ~/op25                    <- op25 build (from scripts/mac-install-op25.sh)
# Repo code stays at /Users/willminkoff/Documents/scannerproject.
# =============================================================================

# ---- base prefixes (everything below derives from these) --------------------
SCANNER_PREFIX=/opt/scannerproject
# The app runs from /opt/scannerproject/app (a deploy copy), NOT the ~/Documents
# git checkout: ~/Documents is TCC-privacy-protected and hangs headless launchd
# processes on the consent check. Deploy = rsync the repo to this path.
SCANNER_REPO=/opt/scannerproject/app

# ---- server / port ----------------------------------------------------------
UI_PORT=5050

# ---- config paths (was /usr/local/etc, /etc/scannerproject) -----------------
CONFIG_DIR=/opt/scannerproject/etc
PROFILES_DIR=/opt/scannerproject/etc/airband-profiles
COMBINED_CONFIG_PATH=/opt/scannerproject/etc/rtl_airband_combined.conf
GROUND_CONFIG_PATH=/opt/scannerproject/etc/rtl_airband_ground.conf
CONFIG_SYMLINK=/opt/scannerproject/etc/rtl_airband.conf
DONGLE_SCHEDULE_CONFIG_PATH=/opt/scannerproject/etc/dongle-schedule.json

# ---- volatile runtime state (was /run/...) ----------------------------------
# /run does not exist on macOS. All of these move under one writable dir that
# the daemon owns. config.py reads each individually.
FILTER_CONFIG_DIR=/opt/scannerproject/run
LAST_HIT_AIRBAND_PATH=/opt/scannerproject/run/rtl_airband_last_freq_airband.txt
LAST_HIT_GROUND_PATH=/opt/scannerproject/run/rtl_airband_last_freq_ground.txt
RTL_AIRBAND_STATS_PATH=/opt/scannerproject/run/rtl_airband_stats.txt
RTL_AIRBAND_AIRBAND_STATS_PATH=/opt/scannerproject/run/rtl_airband_airband_stats.txt
RTL_AIRBAND_GROUND_STATS_PATH=/opt/scannerproject/run/rtl_airband_ground_stats.txt
ICECAST_HIT_LOG_PATH=/opt/scannerproject/run/airband_ui_hitlog.jsonl
HOLD_STATE_PATH=/opt/scannerproject/run/airband_ui_hold.json
DONGLE_POWER_STATE_PATH=/opt/scannerproject/run/airband_ui_dongle_power.json
TUNE_BACKUP_PATH=/opt/scannerproject/run/airband_ui_tune_backup.json
DIGITAL_SCHEDULER_STATE_PATH=/opt/scannerproject/run/airband_ui_digital_scheduler.json
V3_COMPILED_STATE_PATH=/opt/scannerproject/run/airband_ui_v3_compiled_state.json
V3_CANONICAL_CONFIG_PATH=/opt/scannerproject/etc/v3/canonical_config.json
ACARS_OUTPUT_PATH=/opt/scannerproject/run/acars_output.json
VDL2_OUTPUT_PATH=/opt/scannerproject/run/vdl2_output.json

# ---- logs & avoids (was /home/willminkoff/..., /var/log/*) ------------------
AVOIDS_DIR=/Users/willminkoff/Documents/scannerproject/admin/logs

# ---- icecast ----------------------------------------------------------------
ICECAST_HOST=127.0.0.1
ICECAST_PORT=8000
MOUNT_NAME=ANALOG.mp3

# ---- digital backend (op25, headless) ---------------------------------------
DIGITAL_BACKEND=op25
OP25_STATUS_HOST=127.0.0.1
OP25_STATUS_PORT=8080
OP25_RUNTIME_DIR=/opt/scannerproject/run/op25
OP25_INSTANCES_PATH=/opt/scannerproject/run/op25/instances.json
OP25_LOG_PATH=/opt/scannerproject/log/op25.log
OP25_RX_PATH=/Users/willminkoff/op25/op25/gr-op25_repeater/apps/rx.py
OP25_MULTI_RX_PATH=/Users/willminkoff/op25/op25/gr-op25_repeater/apps/multi_rx.py
DIGITAL_PROFILES_DIR=/opt/scannerproject/etc/digital/profiles
DIGITAL_ACTIVE_PROFILE_LINK=/opt/scannerproject/etc/digital/active
DIGITAL_LOG_PATH=/opt/scannerproject/log/digital.log

# ---- weather decoders -------------------------------------------------------
RADIOSONDE_UDP_HOST=127.0.0.1
RADIOSONDE_UDP_PORT=55673

# ---- audio (Path A = local playback wanted; CoreAudio rewrite is M5) --------
# Until the CoreAudio path lands, keep audio flowing via Icecast only. Flip to
# 1 once ui/audio_leveler.py / band_mute.py / op25-audio-bridge.py have their
# CoreAudio backends (see docs/mac-mini-port.md, Milestone 5).
OP25_AUDIO_LOCAL_PLAY=0

# =============================================================================
# SERVICE-CONTROL BACKEND  (consumed by the ui/systemd.py abstraction, M2)
# -----------------------------------------------------------------------------
# macOS has no systemctl. The abstraction dispatches on SCANNER_SERVICE_BACKEND
# and maps these logical unit names to launchd labels / supervisor service ids.
# Names mirror config.py UNITS{} so existing call sites keep working.
SCANNER_SERVICE_BACKEND=launchd
UNIT_RTL_AIRBAND=com.scannerproject.rtl-airband
UNIT_RTL_GROUND=com.scannerproject.rtl-ground
UNIT_RTL=com.scannerproject.rtl-airband
UNIT_GROUND=com.scannerproject.rtl-ground
UNIT_ICECAST=com.scannerproject.icecast
UNIT_KEEPALIVE=com.scannerproject.icecast-keepalive
UNIT_UI=com.scannerproject.airband-ui
OP25_SERVICE_NAME=com.scannerproject.digital-op25
UNIT_DIGITAL_AUDIO=com.scannerproject.digital-op25-audio
UNIT_ACARS=com.scannerproject.acarsdec
UNIT_VDL2=com.scannerproject.dumpvdl2
UNIT_RADIOSONDE=com.scannerproject.radiosonde
# SDRplay API service is a real macOS LaunchDaemon already installed.
UNIT_SDRPLAY=com.sdrplay.service

# ---- home location (radioreference / travel mode) ---------------------------
HOME_ZIP=37221
HOME_LAT=36.0662
HOME_LON=-86.9639

# ---- radioconda GNU Radio toolchain (SB7.1; chirp + all GR run under this) ---
# radioconda provides gnuradio 3.10 + gr-soapy + gnuradio-osmosdr + SoapySDR.
# It is NOT relocatable, so it stays at its install prefix; /opt path is a
# symlink to the real install (~/radioconda) created during provisioning.
RADIOCONDA_PREFIX=/opt/scannerproject/radioconda
# CRITICAL: radioconda's SoapySDR has a compiled-in module search path that does
# NOT survive relocation — without this var, SoapySDRUtil/gr-osmosdr report the
# sdrplay AND rtlsdr drivers MISSING (no RSPduo/RTL will open). Every chirp/GR
# process must inherit it. (M1 provisioning finding, 2026-07-05.)
SOAPY_SDR_PLUGIN_PATH=/opt/scannerproject/radioconda/lib/SoapySDR/modules0.8
# The chirp daemon spawns `lame` as its mp3 encoder subprocess — it must be
# resolvable via PATH (chirp does not invoke it by absolute path). radioconda's
# bin is not on the default macOS PATH. (M1 first-audio finding, 2026-07-05.)
PATH=/opt/scannerproject/radioconda/bin:${PATH}

# ---- macOS file-descriptor limit for GNU Radio -------------------------------
# GNU Radio's vmcircbuf shared-memory ring buffers need far more open file
# descriptors than macOS's default soft limit (256) — chirp fails at flowgraph
# start with "shmat: Too many open files" / "shmget: Invalid argument" without
# this. A shell `ulimit -n 10240` before launching works for manual/SSH runs;
# the eventual chirp LaunchAgent (SB7.5) should set this via its plist's
# SoftResourceLimits/HardResourceLimits NumberOfFiles key instead of relying on
# an inherited shell ulimit (launchd does not source shell rc files).
# (M1 first-audio finding, 2026-07-05.)
CHIRP_REQUIRES_ULIMIT_N=10240

# ---- SB7 UI: chirp is the ONLY analog backend on this box -------------------
# SB5_USE_GR_DEMOD switches the whole UI (status, hit-log reads, squelch/gain
# controls, reset-radios) from the legacy rtl-airband stats-file/journalctl
# path to the chirp adapter (ui/chirp_client.py, ui/chirp_adapter.py). SB7 has
# no rtl-airband service at all -- chirp-airband/chirp-ground ARE the analog
# engine -- so this must be on, not left at its off-by-default. Without it,
# /api/status reports "stats file missing" / inactive for bands that are
# actually live (found during UI macOS bring-up, 2026-07-06).
SB5_USE_GR_DEMOD=true
