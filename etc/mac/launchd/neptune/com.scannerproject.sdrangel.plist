<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.scannerproject.sdrangel</string>
  <key>ProgramArguments</key><array>
    <string>/Applications/SDRangel.app/Contents/MacOS/SDRangel</string>
  </array>
  <!-- GUI app: launch on login into the graphical (Aqua) session so Will sees it via CRD. -->
  <key>RunAtLoad</key><true/>
  <key>LimitLoadToSessionType</key><string>Aqua</string>
  <!-- Restart on crash (non-zero exit) but NOT when Will Quits it cleanly (exit 0). -->
  <key>KeepAlive</key><dict>
    <key>SuccessfulExit</key><false/>
  </dict>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>StandardOutPath</key><string>/Users/willminkoff/scannerproject/logs/sdrangel.out.log</string>
  <key>StandardErrorPath</key><string>/Users/willminkoff/scannerproject/logs/sdrangel.err.log</string>
  <key>EnvironmentVariables</key><dict>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/bin:/bin</string>
  </dict>
</dict></plist>
