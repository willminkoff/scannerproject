    <string>/Users/willminkoff/sdr-trunk-osx-aarch64-v0.6.1/bin/sdr-trunk</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>LimitLoadToSessionType</key><string>Aqua</string>
