<?xml version="1.0" encoding="UTF-8"?>
<!--
  com.scannerproject.sb3-ui — the SB3 web UI (Phase 3.1).

  TEMPLATE. `sb3-ctl install` writes it to ~/Library/LaunchAgents/ after
  substituting {{PYTHON}} / {{REPO_DIR}} / {{HOME}}.

  Runs `python3 -m sb3.ui`: a stdlib http.server (NO Flask — the sb3 package is
  stdlib-only and deploys via a git sparse-checkout with no pip) that serves the
  frozen ui/sb3.html and the /api/* shim, mapping each endpoint onto the SB3
  backend observers. It holds no state of its own, so a kill→resume restart
  reflects live reality with nothing to rebuild.

  SB3-OWNED (sb3/ownership.py): dies on `sb3-ctl kill`, returns on `resume`.
  It is a lease-free consumer, so it stops EARLY in the kill order (with the
  reconciler) — before the brokers.

  KeepAlive={SuccessfulExit:false} — respawn on a crash, not on a clean exit, so
  `launchctl bootout` is a real stop. LimitLoadToSessionType=Aqua — it sits
  alongside the GUI backends.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.scannerproject.sb3-ui</string>

    <key>ProgramArguments</key>
    <array>
        <string>{{PYTHON}}</string>
        <string>-m</string>
        <string>sb3.ui</string>
    </array>

    <key>WorkingDirectory</key>
    <string>{{REPO_DIR}}</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONPATH</key>
        <string>{{REPO_DIR}}</string>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
        <key>SB3_UI_PORT</key>
        <string>5050</string>
        <!-- Deliberately absent, and this is load-bearing. sb3-ui reaches other
             boxes through these, and every one of them used to be a hardcoded
             address in the source (3106e18, 19a2c58, and the commit adding this
             comment). They are deployment facts, not repo facts, so they are not
             written here: this template lives in a public repo, and baking an
             address back in is the bug all three commits removed.

             The live plist on the box must set whichever of these that
             deployment needs. With one absent, sb3-ui fails SAFE but QUIET:
               SB3_CHIRP_AIRBAND_HOST      airband control goes to loopback
               SB3_CHIRP_AIRBAND_LOG_URL   airband hits vanish from /api/hits
               SB3_OP25_APPLY_URL          digital profile apply refuses
               SB3_OP25_REMOTE_URL         op25 health cards read "unknown"
               SB3_SDRTRUNK_REMOTE_URL     sdrtrunk status unavailable
               SB3_VENUS_POWER_URL         dongle power refuses
               SB3_DISCO_URL               disco card reads "unknown"

             sb3.install is dry-run only today (its execute flag is refused), so
             it cannot yet overwrite a configured plist with this one. Before that
             changes, render() needs to carry these through, or the first real
             `sb3-ctl install` silently un-configures a working box.
             After editing the live plist: launchctl bootout then bootstrap.
             `launchctl kickstart -k` does NOT re-read a changed plist. -->
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>LimitLoadToSessionType</key>
    <string>Aqua</string>

    <key>StandardOutPath</key>
    <string>{{HOME}}/Library/Logs/sb3/sb3-ui.out.log</string>
    <key>StandardErrorPath</key>
    <string>{{HOME}}/Library/Logs/sb3/sb3-ui.err.log</string>
</dict>
</plist>
