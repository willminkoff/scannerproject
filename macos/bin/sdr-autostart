#!/bin/bash
# sdr-autostart - install/uninstall the deterministic single-consumer SDR boot agent.
#
# Replaces the "both apps reopen at login and race for the apiService" behavior (memo §C#1)
# with a single launchd user-agent that drives `sdrctl start <consumer>` once at login.
#
# It also disables macOS "reopen windows" for SDRangel so the app can't independently relaunch
# and re-create the race. No sudo: this is a per-user GUI LaunchAgent and a per-app `defaults` key.
#
# USAGE
#   sdr-autostart install [sdrangel|sdrtrunk]   # default consumer = sdrangel
#   sdr-autostart uninstall
#   sdr-autostart status
set -u

REPO="$(cd "$(dirname "$0")/../.." && pwd)"          # .../scannerproject
TEMPLATE="$REPO/macos/launchd/com.scannerproject.sdr-boot.plist"
LABEL="com.scannerproject.sdr-boot"
DEST="$HOME/Library/LaunchAgents/$LABEL.plist"
SDRANGEL_DOMAIN="com.f4exb.SDRangel"
GUI="gui/$(id -u)"

ok()   { printf "  \033[1;32m✓\033[0m %s\n" "$*"; }
warn() { printf "  \033[1;33m!\033[0m %s\n" "$*"; }
die()  { printf "  \033[1;31m✗\033[0m %s\n" "$*"; exit 1; }

cmd="${1:-status}"

case "$cmd" in
  install)
    consumer="${2:-sdrangel}"
    case "$consumer" in sdrangel|sdrtrunk) ;; *) die "consumer must be sdrangel or sdrtrunk";; esac
    [ -f "$TEMPLATE" ] || die "template not found: $TEMPLATE"

    # 1. stop SDRangel from relaunching itself at login (the other half of the race)
    defaults write "$SDRANGEL_DOMAIN" NSQuitAlwaysKeepsWindows -bool false \
      && ok "disabled reopen-on-login for SDRangel ($SDRANGEL_DOMAIN NSQuitAlwaysKeepsWindows=false)"

    # 2. render template -> ~/Library/LaunchAgents
    mkdir -p "$HOME/Library/LaunchAgents"
    sed -e "s#__REPO__#$REPO#g" -e "s#__CONSUMER__#$consumer#g" "$TEMPLATE" > "$DEST" \
      && ok "rendered $DEST (consumer=$consumer)"

    # 3. (re)load the agent
    launchctl bootout "$GUI/$LABEL" 2>/dev/null || true
    if launchctl bootstrap "$GUI" "$DEST" 2>/dev/null; then
      ok "boot agent loaded ($LABEL)"
    else
      die "launchctl bootstrap failed for $DEST"
    fi
    echo "    Boots '$consumer' as the single consumer at login. Verify now without a reboot:"
    echo "      launchctl kickstart $GUI/$LABEL   # then: sdrctl status"
    ;;

  uninstall)
    launchctl bootout "$GUI/$LABEL" 2>/dev/null && ok "boot agent unloaded" || warn "agent was not loaded"
    [ -f "$DEST" ] && rm -f "$DEST" && ok "removed $DEST"
    defaults delete "$SDRANGEL_DOMAIN" NSQuitAlwaysKeepsWindows 2>/dev/null \
      && ok "restored SDRangel reopen-on-login default" || warn "SDRangel reopen key already default"
    ;;

  status)
    echo "boot agent ($LABEL):"
    if launchctl print "$GUI/$LABEL" >/dev/null 2>&1; then ok "loaded"; else warn "not loaded"; fi
    [ -f "$DEST" ] && ok "installed plist: $DEST" || warn "no installed plist"
    v="$(defaults read "$SDRANGEL_DOMAIN" NSQuitAlwaysKeepsWindows 2>/dev/null || echo unset)"
    echo "  SDRangel reopen-on-login (NSQuitAlwaysKeepsWindows): $v  (false = disabled, good)"
    ;;

  *) die "usage: sdr-autostart {install [consumer]|uninstall|status}";;
esac
