#!/usr/bin/env python3
"""
sdrctl - deterministic single-consumer arbiter for the ScannerBox SDRplay stack.

WHY THIS EXISTS
    SDRangel (analog) and SDRTrunk (digital P25) both consume the shared SDRplay
    apiService (com.sdrplay.service). When both relaunch at login and enumerate at
    the same time they fight over the apiService: whoever opens first wins, the other
    sees "Discovered [0] RSP devices" / "No Tuner Available" (the macos-transition-memo
    section C.1 wart). The deterministic fix for bring-up is to never let both grab the
    device at once: ONE consumer on the apiService at a time, started deliberately.

    sdrctl is that deliberate single entry point. `start X` first gracefully stops the
    other consumer, waits out the rspduo open-gap, then launches X and verifies it
    actually acquired its RSPduo.

CLEAN RELEASE
    Graceful stop sends SIGTERM. SDRTrunk now carries a JVM shutdown hook (added to
    io.github.dsheirer.gui.SDRTrunk) that releases each SDRplay device + closes the API
    on SIGTERM, so the device frees immediately instead of lingering ~22s in the
    apiService (memo section C.3). SIGKILL is only a last-resort fallback if a process
    ignores SIGTERM.

DIRTY-DAEMON REMEDIATION (2026-07-03)
    SDRangel has NO shutdown hook: when it segfaults while streaming an SDRplay device,
    the apiService is left with leaked libusb refs and a half-destroyed mutex
    ("pthread_mutex_destroy: Resource busy" in /Library/Logs/sdrplayservice_err.log).
    Every later sdrplay_api_Init then segfaults inside sdrplay_api_device::mutexLock -
    i.e. starting ANY new SDRplay radio crashes the client. The only cure is restarting
    the daemon. Before starting a consumer, sdrctl now checks for SDRangel crash reports
    (~/Library/Logs/DiagnosticReports/SDRangel-*.ips) NEWER than the apiService process
    start: if any exist, the daemon is presumed dirty and gets a kickstart first. That
    needs root, so install the one-command scoped sudoers rule once:
        sudo macos/bin/install-sdrctl-sudoers.sh
    Without the rule, sdrctl prints the manual command and continues with a warning.

USAGE
    sdrctl kickstart                              # manual daemon restart (uses the sudoers rule)

POLICY
    Device->role mapping and timing invariants are read best-effort from
    etc/mac/sdr_fleet_policy.json (rspduo_open_gap_sec, min_restart_interval_sec). The
    file is the single source of truth; sdrctl falls back to safe defaults if it is absent.

RESTART THROTTLE
    Rapid stop/start of the RSPduo wedges the shared SDRplay apiService (it leaks USB device
    references; decode degrades to garbage until a reboot or service kickstart). So before
    opening the device, sdrctl waits out min_restart_interval_sec since the last open (stamped
    in ~/.scannerproject/sdrctl_state.json). Pass --force to skip the wait (not recommended).

USAGE
    sdrctl status
    sdrctl start  <sdrangel|sdrtrunk> [--force]   # stops the other consumer first (single-consumer)
    sdrctl stop   <sdrangel|sdrtrunk|all>
    sdrctl restart <sdrangel|sdrtrunk> [--force]
"""
from __future__ import annotations

import argparse
import json
import os
import signal
import subprocess
import sys
import time
import urllib.request
from pathlib import Path

HOME = Path.home()
REPO = Path(__file__).resolve().parents[2]          # .../scannerproject
POLICY_FILE = REPO / "etc" / "mac" / "sdr_fleet_policy.json"

SDRANGEL_REST = "http://127.0.0.1:8091/sdrangel"
SDRTRUNK_LAUNCHER = HOME / "SDRTrunk" / "bin" / "sdr-trunk"
SDRTRUNK_APP_LOG = HOME / "SDRTrunk" / "logs" / "sdrtrunk_app.log"
SDRTRUNK_OUT = "/tmp/sdrtrunk.out"
STATE_FILE = HOME / ".scannerproject" / "sdrctl_state.json"   # records last RSPduo open

# Process match patterns (pgrep -f)
MATCH = {
    "sdrangel": "SDRangel.app/Contents/MacOS/SDRangel",
    "sdrtrunk": "io.github.dsheirer",          # the running SDRTrunk JVM
}
APISERVICE_PROC = "sdrplay_apiService"
APISERVICE_LAUNCHD = "system/com.sdrplay.service"
CRASH_DIR = HOME / "Library" / "Logs" / "DiagnosticReports"
# Exact command the sudoers rule whitelists (install-sdrctl-sudoers.sh); -n = never prompt.
KICKSTART_CMD = ["sudo", "-n", "/bin/launchctl", "kickstart", "-k", APISERVICE_LAUNCHD]

# Safe defaults; overridden by the fleet policy when present.
DEFAULTS = {"rspduo_open_gap_sec": 2.0, "min_restart_interval_sec": 30}

# ----------------------------------------------------------------------------- output
def _c(code: str, s: str) -> str:
    return s if not sys.stdout.isatty() else f"\033[{code}m{s}\033[0m"

def step(msg: str) -> None: print(_c("1;36", f"== {msg} =="))
def ok(msg: str) -> None:   print("  " + _c("1;32", "✓") + f" {msg}")
def warn(msg: str) -> None: print("  " + _c("1;33", "!") + f" {msg}")
def err(msg: str) -> None:  print("  " + _c("1;31", "✗") + f" {msg}")

# ----------------------------------------------------------------------------- policy
def load_policy() -> dict:
    inv = dict(DEFAULTS)
    try:
        data = json.loads(POLICY_FILE.read_text())
        for k in DEFAULTS:
            if k in data.get("invariants", {}):
                inv[k] = data["invariants"][k]
        inv["_devices"] = {d["serial"]: d for d in data.get("devices", []) if d.get("kind") == "rspduo"}
    except FileNotFoundError:
        warn(f"fleet policy not found ({POLICY_FILE}); using defaults")
        inv["_devices"] = {}
    except (json.JSONDecodeError, KeyError) as e:
        warn(f"fleet policy unreadable ({e}); using defaults")
        inv["_devices"] = {}
    return inv

# ------------------------------------------------------------------- restart throttle
def _read_state() -> dict:
    try:
        return json.loads(STATE_FILE.read_text())
    except (FileNotFoundError, json.JSONDecodeError, OSError):
        return {}

def _record_open() -> None:
    """Stamp the time of the most recent RSPduo open (a consumer launch)."""
    try:
        STATE_FILE.parent.mkdir(parents=True, exist_ok=True)
        st = _read_state()
        st["last_open"] = time.time()
        STATE_FILE.write_text(json.dumps(st))
    except OSError:
        pass

def _throttle_restart(policy: dict, force: bool) -> None:
    """Honor min_restart_interval_sec. Rapid stop/start of the RSPduo wedges the shared SDRplay
    apiService (it leaks USB device references; decode degrades to garbage until a reboot/kickstart).
    So we refuse to re-open the device faster than the policy interval unless --force is given."""
    interval = float(policy["min_restart_interval_sec"])
    last = _read_state().get("last_open")
    if last is None or interval <= 0:
        return
    remaining = interval - (time.time() - last)
    if remaining <= 0:
        return
    if force:
        warn(f"--force: skipping {remaining:.0f}s min-restart-interval wait (risks wedging the apiService)")
        return
    ok(f"min-restart-interval: last RSPduo open was {interval - remaining:.0f}s ago; "
       f"waiting {remaining:.0f}s (policy {interval:.0f}s) to avoid wedging the apiService")
    time.sleep(remaining)

# ----------------------------------------------------------------------------- procs
def pids(consumer: str) -> list[int]:
    try:
        out = subprocess.run(["pgrep", "-f", MATCH[consumer]], capture_output=True, text=True)
        return [int(p) for p in out.stdout.split()] if out.returncode == 0 else []
    except FileNotFoundError:
        return []

def running(consumer: str) -> bool:
    return bool(pids(consumer))

def apiservice_up() -> bool:
    return subprocess.run(["pgrep", "-x", APISERVICE_PROC], capture_output=True).returncode == 0

# ------------------------------------------------------- dirty-daemon remediation
def _apiservice_start_time() -> float | None:
    """Epoch time the apiService process started, or None if it isn't running."""
    out = subprocess.run(["pgrep", "-x", APISERVICE_PROC], capture_output=True, text=True)
    if out.returncode != 0 or not out.stdout.strip():
        return None
    pid = out.stdout.split()[0]
    et = subprocess.run(["ps", "-o", "etime=", "-p", pid],
                        capture_output=True, text=True).stdout.strip()
    if not et:
        return None
    # etime is [[dd-]hh:]mm:ss (locale-safe, unlike lstart)
    days, rest = et.split("-", 1) if "-" in et else ("0", et)
    parts = [int(p) for p in rest.split(":")]
    while len(parts) < 3:
        parts.insert(0, 0)
    return time.time() - (int(days) * 86400 + parts[0] * 3600 + parts[1] * 60 + parts[2])

def _sdrangel_crashes_since(t: float) -> list[Path]:
    """SDRangel crash reports written after epoch t. A crash while a device was
    streaming leaves the apiService with leaked refs + a corrupt mutex; any report
    newer than the daemon's start means the daemon may be dirty."""
    try:
        return sorted((p for p in CRASH_DIR.glob("SDRangel-*.ips") if p.stat().st_mtime > t),
                      key=lambda p: p.stat().st_mtime)
    except OSError:
        return []

def apiservice_dirty() -> list[Path]:
    """Crash reports implicating the current apiService incarnation ([] = presumed clean)."""
    started = _apiservice_start_time()
    return _sdrangel_crashes_since(started) if started is not None else []

def kickstart_apiservice() -> bool:
    """Restart com.sdrplay.service via the scoped sudoers rule; verify it comes back."""
    step("Kickstarting com.sdrplay.service (clears dirty client state)")
    r = subprocess.run(KICKSTART_CMD, capture_output=True, text=True)
    if r.returncode != 0:
        err("passwordless kickstart unavailable (sudoers rule not installed?)")
        err("run manually:  sudo launchctl kickstart -k " + APISERVICE_LAUNCHD)
        err(f"enable auto-remediation once:  sudo {REPO}/macos/bin/install-sdrctl-sudoers.sh")
        return False
    time.sleep(1.0)                       # let the old process die before polling
    deadline = time.time() + 15.0
    while time.time() < deadline:
        started = _apiservice_start_time()
        if started is not None and time.time() - started < 20.0:
            ok("apiService restarted (fresh process, dirty state cleared)")
            return True
        time.sleep(0.5)
    err("apiService did not come back within 15s after kickstart")
    return False

def sdrangel_devices() -> list[dict] | None:
    """Return SDRangel's device-set list via REST, or None if the API is unreachable."""
    try:
        with urllib.request.urlopen(SDRANGEL_REST, timeout=3) as r:
            data = json.loads(r.read().decode())
        return data.get("devicesetlist", {}).get("deviceSets", [])
    except Exception:
        return None

# ----------------------------------------------------------------------------- stop
def stop(consumer: str, timeout: float = 30.0) -> bool:
    """Graceful SIGTERM, poll until the process exits. SIGKILL only as last resort."""
    ps = pids(consumer)
    if not ps:
        ok(f"{consumer} already stopped")
        return True
    step(f"Stopping {consumer} (graceful SIGTERM, pid {','.join(map(str, ps))})")
    for p in ps:
        try:
            os.kill(p, signal.SIGTERM)
        except ProcessLookupError:
            pass
    deadline = time.time() + timeout
    while time.time() < deadline:
        if not running(consumer):
            ok(f"{consumer} exited cleanly")
            return True
        time.sleep(0.5)
    # Last resort
    warn(f"{consumer} did not exit within {timeout:.0f}s; sending SIGKILL")
    for p in pids(consumer):
        try:
            os.kill(p, signal.SIGKILL)
        except ProcessLookupError:
            pass
    time.sleep(1.0)
    if running(consumer):
        err(f"{consumer} still running after SIGKILL")
        return False
    warn(f"{consumer} killed (NOT a clean release - the apiService may hold the device briefly)")
    return True

# ----------------------------------------------------------------------------- start
def _verify_sdrangel(timeout: float = 20.0) -> bool:
    deadline = time.time() + timeout
    while time.time() < deadline:
        ds = sdrangel_devices()
        if ds:
            ok(f"SDRangel REST up; {len(ds)} device set(s)")
            return True
        time.sleep(1.0)
    warn("SDRangel REST did not report device sets within timeout (check the GUI)")
    return False

def _verify_sdrtrunk(timeout: float = 25.0) -> bool:
    """Watch the app log for 'Discovered [N] RSP devices' with N>=1."""
    deadline = time.time() + timeout
    start_size = SDRTRUNK_APP_LOG.stat().st_size if SDRTRUNK_APP_LOG.exists() else 0
    while time.time() < deadline:
        if SDRTRUNK_APP_LOG.exists():
            try:
                with SDRTRUNK_APP_LOG.open() as f:
                    f.seek(start_size)
                    for line in f:
                        if "Discovered [" in line and "RSP" in line:
                            n = line.split("Discovered [", 1)[1].split("]", 1)[0]
                            if n.strip().isdigit() and int(n) >= 1:
                                ok(f"SDRTrunk discovered [{n}] RSP device(s)")
                                return True
                            if n.strip() == "0":
                                warn("SDRTrunk discovered [0] RSP devices - apiService not free?")
                                return False
            except OSError:
                pass
        time.sleep(1.0)
    warn("SDRTrunk acquisition not confirmed in log within timeout")
    return False

def start(consumer: str, policy: dict, force: bool = False) -> bool:
    other = "sdrtrunk" if consumer == "sdrangel" else "sdrangel"
    # Single-consumer invariant: never let both hold the apiService.
    if running(other):
        warn(f"single-consumer: {other} is running - stopping it first")
        if not stop(other):
            err(f"could not stop {other}; aborting start of {consumer}")
            return False
        gap = float(policy["rspduo_open_gap_sec"])
        ok(f"waiting {gap:.1f}s rspduo open-gap before opening {consumer}")
        time.sleep(gap)

    if running(consumer):
        ok(f"{consumer} already running (pid {','.join(map(str, pids(consumer)))})")
        return True

    if not apiservice_up():
        warn(f"{APISERVICE_PROC} is not running - attempting kickstart")
        if not kickstart_apiservice():
            err(f"{APISERVICE_PROC} is not running - start com.sdrplay.service first")
            return False
    else:
        crashes = apiservice_dirty()
        if crashes:
            warn(f"{len(crashes)} SDRangel crash report(s) newer than the apiService "
                 f"(latest: {crashes[-1].name}) - daemon presumed dirty")
            if not kickstart_apiservice():
                warn("continuing WITHOUT kickstart - sdrplay_api_Init may segfault on device start")

    # Don't re-open the RSPduo faster than the policy interval (prevents apiService wedge).
    _throttle_restart(policy, force)

    step(f"Starting {consumer}")
    _record_open()
    if consumer == "sdrangel":
        subprocess.run(["open", "-a", "/Applications/SDRangel.app"], check=False)
        ok("SDRangel launched (open -a)")
        return _verify_sdrangel()
    else:
        if not SDRTRUNK_LAUNCHER.exists():
            err(f"SDRTrunk launcher missing: {SDRTRUNK_LAUNCHER}")
            return False
        with open(SDRTRUNK_OUT, "wb") as out:
            subprocess.Popen([str(SDRTRUNK_LAUNCHER)], stdout=out, stderr=subprocess.STDOUT,
                             stdin=subprocess.DEVNULL, start_new_session=True)
        ok(f"SDRTrunk launched (headless, log: {SDRTRUNK_APP_LOG})")
        return _verify_sdrtrunk()

# ----------------------------------------------------------------------------- status
def cmd_status(policy: dict) -> int:
    step("SDR fleet status")
    print("  apiService (com.sdrplay.service): " + ("up" if apiservice_up() else _c("1;31", "DOWN")))
    crashes = apiservice_dirty()
    if crashes:
        warn(f"presumed DIRTY: {len(crashes)} SDRangel crash(es) since the daemon started "
             f"(latest: {crashes[-1].name}); `sdrctl kickstart` to clear")
    both = [c for c in ("sdrangel", "sdrtrunk") if running(c)]
    for c in ("sdrangel", "sdrtrunk"):
        if running(c):
            ok(f"{c}: running (pid {','.join(map(str, pids(c)))})")
        else:
            print(f"  - {c}: stopped")
    analog_rsp = False
    if "sdrangel" in both:
        ds = sdrangel_devices() or []
        print(f"      SDRangel REST: {len(ds)} device set(s) on :8091")
        # the real invariant is ONE SDRplay-apiService consumer; SDRangel on RTL/file coexists fine
        analog_rsp = any("RSP" in ((d.get("samplingDevice") or {}).get("hwType") or "")
                         or "SDRplay" in ((d.get("samplingDevice") or {}).get("hwType") or "") for d in ds)
    if len(both) == 2:
        if analog_rsp:
            warn("BOTH on the SDRplay apiService - contention; `sdrctl start <one>` to reconcile")
        else:
            ok("coexisting: SDRangel on non-SDRplay hardware (RTL/file), SDRTrunk on the RSPduo")
    return 0

# ----------------------------------------------------------------------------- main
def main() -> int:
    ap = argparse.ArgumentParser(prog="sdrctl", description="single-consumer SDRplay arbiter")
    sub = ap.add_subparsers(dest="cmd", required=True)
    sub.add_parser("status")
    sub.add_parser("kickstart", help="restart com.sdrplay.service (clears dirty state after a client crash)")
    sub.add_parser("kickstart-if-dirty",
                   help="kickstart only when SDRangel crash reports postdate the daemon (watchdog-safe no-op otherwise)")
    sp = sub.add_parser("start"); sp.add_argument("consumer", choices=["sdrangel", "sdrtrunk"])
    sp.add_argument("--force", action="store_true", help="skip the min-restart-interval wait")
    st = sub.add_parser("stop");  st.add_argument("consumer", choices=["sdrangel", "sdrtrunk", "all"])
    rs = sub.add_parser("restart"); rs.add_argument("consumer", choices=["sdrangel", "sdrtrunk"])
    rs.add_argument("--force", action="store_true", help="skip the min-restart-interval wait")
    args = ap.parse_args()

    policy = load_policy()

    if args.cmd == "status":
        return cmd_status(policy)
    if args.cmd == "kickstart":
        for c in ("sdrangel", "sdrtrunk"):
            if running(c):
                warn(f"{c} is running and will lose its device - stopping it first")
                if not stop(c):
                    return 1
        return 0 if kickstart_apiservice() else 1
    if args.cmd == "kickstart-if-dirty":
        crashes = apiservice_dirty()
        if not crashes:
            ok("apiService presumed clean (no SDRangel crashes since it started)")
            return 0
        warn(f"{len(crashes)} SDRangel crash(es) since the daemon started "
             f"(latest: {crashes[-1].name}) - kickstarting")
        for c in ("sdrangel", "sdrtrunk"):
            if running(c):
                warn(f"{c} is running and will lose its device - stopping it first")
                if not stop(c):
                    return 1
        return 0 if kickstart_apiservice() else 1
    if args.cmd == "stop":
        targets = ["sdrangel", "sdrtrunk"] if args.consumer == "all" else [args.consumer]
        return 0 if all(stop(t) for t in targets) else 1
    if args.cmd == "start":
        return 0 if start(args.consumer, policy, args.force) else 1
    if args.cmd == "restart":
        stop(args.consumer)
        time.sleep(float(policy["rspduo_open_gap_sec"]))
        return 0 if start(args.consumer, policy, args.force) else 1
    return 2

if __name__ == "__main__":
    sys.exit(main())
