+    /**
+     * Releases all tuners and closes the SDRplay API.  Safe to call multiple times and from any
+     * thread - the underlying TunerManager.stop() runs at most once, guarded by {@link #mTunersReleased}.
+     *
+     * Invoked both from the normal GUI shutdown sequence ({@link #processShutdown()}) and from a JVM
+     * shutdown hook registered in the constructor, so a SIGTERM/kill (including headless operation,
+     * where processShutdown() is never reached) still cleanly releases SDRplay devices instead of
+     * leaving them open in the apiService.  Deliberately does NOT touch any GUI state so it is safe to
+     * run headless.
+     */
+    private void releaseTuners()
+    {
+        if(mTunerManager != null && mTunersReleased.compareAndSet(false, true))
+        {
+            mTunerManager.stop();
+        }
+    }
