<!-- Sanitized reference for Micro's /etc/icecast2/icecast.xml.
     Passwords are REDACTED here on purpose — do NOT commit real credentials
     (this repo is pushed to GitHub). The live file on the host keeps its real
     source/admin passwords; this example mirrors structure only.

     CORS: the <http-headers> block below is added by
     icecast/deploy_cors_header.sh so the sb5 browser player can run live
     streams through Web Audio. '*' is fine on the trusted LAN; lock to a
     specific origin later if desired. -->
<icecast>
  <location>SprontPi</location>
  <admin>admin@localhost</admin>

  <limits>
    <clients>100</clients>
    <sources>10</sources>
    <threadpool>5</threadpool>
    <queue-size>16384</queue-size>
    <client-timeout>30</client-timeout>
    <header-timeout>15</header-timeout>
    <source-timeout>10</source-timeout>
    <burst-size>2048</burst-size>
  </limits>

  <authentication>
    <source-password>__REDACTED__</source-password>
    <relay-password>__REDACTED__</relay-password>
    <admin-user>source</admin-user>
    <admin-password>__REDACTED__</admin-password>
  </authentication>

  <listen-socket>
    <port>8000</port>
  </listen-socket>

  <!-- Keep analog and digital mounts isolated during source restarts. -->
  <mount>
    <mount-name>/ANALOG.mp3</mount-name>
    <type>audio/mpeg</type>
    <fallback-mount>/keepalive-analog.mp3</fallback-mount>
    <fallback-override>1</fallback-override>
  </mount>

  <mount>
    <mount-name>/ANALOG_GROUND.mp3</mount-name>
    <type>audio/mpeg</type>
    <fallback-mount>/keepalive-ground.mp3</fallback-mount>
    <fallback-override>1</fallback-override>
  </mount>

  <mount>
    <mount-name>/DIGITAL.mp3</mount-name>
    <type>audio/mpeg</type>
    <fallback-mount>/keepalive-digital.mp3</fallback-mount>
    <fallback-override>1</fallback-override>
  </mount>

  <!-- NOTE: chirp test mounts (/CHIRP_TEST.mp3, /CHIRP_GROUND_TEST.mp3) are
       managed separately by chirp/scripts/*.sh and are omitted here. -->

  <!-- ADDED by icecast/deploy_cors_header.sh -->
  <http-headers>
    <header name="Access-Control-Allow-Origin" value="*" />
  </http-headers>

  <paths>
    <basedir>/usr/share/icecast2</basedir>
    <logdir>/var/log/icecast2</logdir>
    <webroot>/usr/share/icecast2/web</webroot>
    <adminroot>/usr/share/icecast2/admin</adminroot>
    <alias source="/" destination="/status.xsl"/>
  </paths>

  <logging>
    <accesslog>access.log</accesslog>
    <errorlog>error.log</errorlog>
    <loglevel>3</loglevel>
    <logsize>10000</logsize>
  </logging>

  <security>
    <chroot>0</chroot>
  </security>
</icecast>
